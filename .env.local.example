# Supabase project config. Copy this file to `.env.local` and fill in real
# values — never commit `.env.local` or any real secret.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The production domain Springboard is served from (e.g.
# https://springboard.phd-nigeria.com) — resolves canonical URLs and
# absolute Open Graph/Twitter image URLs (see metadataBase in
# src/app/layout.tsx). Optional for local dev; required before a real
# production deploy.
NEXT_PUBLIC_SITE_URL=

# Server-only — bypasses Row Level Security. Never prefix with NEXT_PUBLIC_,
# never import the module that uses this into client-bundled code
# (see src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — authenticates the scheduled-publish cron endpoint
# (src/app/api/cron/publish-scheduled/route.ts). Generate with, e.g.,
# `openssl rand -hex 32`. Whatever calls this route (Vercel Cron per
# vercel.json, or any other scheduler) must send it as
# `Authorization: Bearer <value>`.
CRON_SECRET=
