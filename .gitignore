# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local-only dev fixture data — never real/fake editorial content in git
/supabase/dev-seed.sql

# local source photographs and converted copies — never commit
/assets/
/assets-converted/

# Q3 seed source material: staff photographs and unpublished newsletter text. Kept in private storage,
# never in this public repository (see docs/redesign/q3-2026-seed/README.md).
/docs/redesign/q3-2026-seed/photos/
/docs/redesign/q3-2026-seed/q3-2026.json
